{
  "name": "clipflow",
  "displayName": "ClipFlow",
  "version": "0.4.3",
  "description": "跨网页复制内容收集器：自动记录你在任意网页复制的文本，随时搜索、整理并一键合并导出。",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "icons": "python3 scripts/gen-icons.py",
    "dev": "concurrently -k -n ext,panel \"vite build --watch -c vite.extension.config.ts\" \"vite build --watch\"",
    "build": "npm run icons && vite build && vite build -c vite.extension.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "zip": "node scripts/pack-zip.mjs"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "dayjs": "^1.11.13",
    "idb": "^8.0.2",
    "markdown-it": "^14.1.0",
    "naive-ui": "^2.41.0",
    "pinia": "^3.0.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
